{
  "template": "#{{CHANGELOG}}",
  "categories": [
    {
      "title": "## 💥 破坏性变更",
      "labels": ["BREAKING"]
    },
    {
      "title": "## 🚀 新功能",
      "labels": ["feat", "feature"]
    },
    {
      "title": "## 🐛 修复",
      "labels": ["fix", "bug"]
    },
    {
      "title": "## 📝 其他",
      "labels": []
    }
  ],
  "label_extractor": [
    {
      "pattern": "^(build|chore|ci|docs|feat|fix|perf|refactor|revert|style|test){1}(\\([\\w\\-\\.]+\\))?(!)?: ",
      "on_property": "title",
      "target": "$1"
    },
    {
      "pattern": "!:",
      "on_property": "title",
      "target": "BREAKING"
    },
    {
      "pattern": "BREAKING[ -]CHANGE",
      "on_property": "body",
      "target": "BREAKING"
    }
  ]
}
