+async fn wait_for<F, Fut>(check: F, timeout_ms: u64, what: &str)
+where
+    F: Fn() -> Fut,
+    Fut: std::future::Future<Output = bool>,
+{
+    let mut waited = 0u64;
+    while waited < timeout_ms {
+        if check().await {
+            return;
+        }
+        sleep(Duration::from_millis(200)).await;
+        waited += 200;
+    }
+    panic!("超时未达成：{what}");
+}
