{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node", "@wdio/globals", "@wdio/mocha-framework", "webdriverio"]
  },
  "include": ["specs/**/*.ts", "helpers/**/*.ts", "wdio.conf.ts"]
}
